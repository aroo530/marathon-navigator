{
  "expo": {
    "name": "marathon-navigator",
    "slug": "marathon-navigator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marathonnavigator",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marathonnavigator.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f8f8f8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.marathonnavigator.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Marathon Navigator",
      "shortName": "Marathon",
      "description": "Track your marathon progress, attendance, and challenges",
      "themeColor": "#46178f",
      "backgroundColor": "#f8f8f8",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8f8f8"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ed863f5-c2f1-4098-ba75-0f7341671f6c"
      }
    }
  }
}
